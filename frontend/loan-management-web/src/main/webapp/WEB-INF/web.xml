<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>Blessed Winds Loans</display-name>

    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:applicationContext.xml</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <filter>
        <filter-name>pageAuthorizationFilter</filter-name>
        <filter-class>com.alganiug.systems.loanManagement.web.security.PageAuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>pageAuthorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>Document Preview</servlet-name>
        <servlet-class>com.alganiug.systems.loanManagement.web.DocumentPreviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Document Preview</servlet-name>
        <url-pattern>/documents/content/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <error-page>
        <error-code>404</error-code>
        <location>/pages/error/404.xhtml</location>
    </error-page>
    <welcome-file-list>
        <welcome-file>pages/external/login.xhtml</welcome-file>
    </welcome-file-list>
</web-app>
